# ProShop Cloud Capstone environment
# Copy this file to .env before running docker compose.

NODE_ENV=production
PORT=5000

# MongoDB is not exposed to the Internet. Keep passwords strong on EC2.
MONGO_DATABASE=proshop
MONGO_ROOT_USERNAME=proshop_root
MONGO_ROOT_PASSWORD=change_this_mongo_root_password

# Application secrets
JWT_SECRET=change_this_jwt_secret_at_least_32_chars
PAYPAL_CLIENT_ID=sb

# Public domain for HTTPS setup, e.g. shop.example.com
DOMAIN=example.com

# Grafana is exposed only through Nginx at /grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# AlertManager Telegram receiver. Create a Telegram bot with @BotFather.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=0
